{
  "name": "the-gavel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write src e2e scripts .github package.json pnpm-workspace.yaml next.config.ts tsconfig.json eslint.config.mjs .prettierrc.json vitest.config.ts vitest.setup.ts playwright.config.ts README.md docs/testing.md docs/decisions",
    "format:check": "prettier --check src e2e scripts .github package.json pnpm-workspace.yaml next.config.ts tsconfig.json eslint.config.mjs .prettierrc.json vitest.config.ts vitest.setup.ts playwright.config.ts README.md docs/testing.md docs/decisions",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:db": "supabase test db",
    "test:e2e": "playwright test",
    "db:types": "node scripts/database-types/database-types.mjs",
    "db:types:check": "node scripts/database-types/database-types.mjs --check"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "jsdom": "^30.1.3",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "supabase": "^2.121.0",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@11.25.0"
}
